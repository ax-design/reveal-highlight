{
    "name": "@ax-design/reveal-highlight",
    "version": "0.7.0",
    "description": "Web component that implements Reveal Highlight of Axiom Design System.",
    "main": "build/main.js",
    "module": "es/index.js",
    "typings": "es/index.d.ts",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ax-design/reveal-highlight.git"
    },
    "license": "MIT",
    "sideEffects": false,
    "devDependencies": {
        "playwright": "^1.64.0",
        "typescript": "^5.6.0"
    },
    "scripts": {
        "build": "bun scripts/build.ts",
        "check": "tsc -p tsconfig.json --noEmit",
        "test:browser": "bun test-browser/run.ts",
        "prepublishOnly": "bun run build"
    },
    "files": [
        "build",
        "es",
        "src"
    ],
    "dependencies": {
        "@ax-design/shape": "^0.3.0",
        "@ax-design/surface": "^0.3.0",
        "@ax-design/typed-om": "^0.1.0"
    },
    "homepage": "https://github.com/ax-design/reveal-highlight#readme",
    "bugs": {
        "url": "https://github.com/ax-design/reveal-highlight/issues"
    },
    "exports": {
        ".": {
            "types": "./es/index.d.ts",
            "source": "./src/index.ts",
            "import": "./es/index.js",
            "require": "./build/main.js",
            "default": "./es/index.js"
        },
        "./package.json": "./package.json"
    }
}
